<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rubens_DnD__project.DeleteProfilePage"
             Title="DeleteProfilePage">
    <VerticalStackLayout>
        <Label x:Name="TitleLabel" Text="Ta bort profil?" />
        <Entry x:Name="ConfirmEntry" Placeholder="Skriv RADERA här"/>
        <Button Text="Avbryt" Clicked="CancelClicked"/>
        <Button Text="Ta bort" Clicked="DeleteClicked"/>
    </VerticalStackLayout>
    
</ContentPage>